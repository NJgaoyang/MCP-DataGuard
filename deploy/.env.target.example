# Optional server-only target DB secrets, NOT for committing.
# Copy to deploy/.env.target with mode 600, then supply real restricted READ credentials.
# Reference just the prefix from Web admin read-secret API.
# DG_TARGET_REPORTING_READ_USER=replace_with_readonly_db_user
# DG_TARGET_REPORTING_READ_PASSWORD=replace_with_private_secret
# Operate with DG_CONNECT_TEST_ALLOW_HOSTS=reporting.example.internal in .env.dev.
