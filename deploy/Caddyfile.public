{
    # Also handles HTTPS connections to bare IPv4 addresses (without SNI).
    default_sni {$DG_PUBLIC_HOST}
}

{$DG_PUBLIC_HOST} {
    # Let's Encrypt IP certificates must use the shortlived profile.
    # Automatic renewal is handled by Caddy.
    tls {
        issuer acme {
            profile shortlived
        }
    }
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
    }
    handle /identity/* {
        respond "Identity provider no longer installed" 404
    }
    handle {
        header X-Frame-Options DENY
        reverse_proxy web:8080
    }
}
