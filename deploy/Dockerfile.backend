FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY . .
ARG SERVICE=dataguard-server
RUN mvn -B -ntp -pl "${SERVICE}" -am -DskipTests package && \
    mvn -B -ntp -pl "${SERVICE}" spring-boot:repackage
FROM eclipse-temurin:21-jre
WORKDIR /app
ARG SERVICE=dataguard-server
COPY --from=build /src/${SERVICE}/target/${SERVICE}-0.5.0-SNAPSHOT.jar /app/app.jar
USER 10001
ENTRYPOINT ["java","-jar","/app/app.jar"]
