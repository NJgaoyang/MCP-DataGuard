# Copy to deploy/.env.dev, chmod 600, and configure. DO NOT COMMIT LIVE SECRETS.
PG_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_SECRET
PG_PLATFORM_USER=dg_platform
PG_PLATFORM_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
PG_FLOWABLE_USER=dg_flowable
PG_FLOWABLE_PASSWORD=REPLACE_WITH_THIRD_RANDOM_SECRET
PG_HOST_PORT=55432
OIDC_ISSUER=https://idp.example.invalid/realms/dataguard
OIDC_AUDIENCE=mcp-dataguard
VITE_OIDC_AUTHORITY=https://idp.example.invalid/realms/dataguard
VITE_OIDC_CLIENT_ID=dataguard-web
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:18080/auth/callback
DG_WEB_LOCAL_PORT=18080
DG_ENABLE_READ_EXECUTION=false
FLOWABLE_SCHEMA_UPDATE=true
