# chmod 600 /etc/dataguard/standalone.env; owner root; protected file.
# Initial setup uses DATAGUARD_FLOWABLE_SCHEMA_UPDATE=true ONCE under change control;
# afterwards revert to false. Database must already exist.
DATAGUARD_BIND=127.0.0.1
DATAGUARD_PORT=8080
DATAGUARD_COOKIE_SECURE=false
DATAGUARD_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/dataguard?sslMode=REQUIRED&connectionTimeZone=UTC
DATAGUARD_MYSQL_USER=dataguard
DATAGUARD_MYSQL_PASSWORD=REPLACE_WITH_INDIVIDUAL_32_CHAR_SECRET
DATAGUARD_BOOTSTRAP_ADMIN=true
DATAGUARD_FLOWABLE_SCHEMA_UPDATE=false
DATAGUARD_READ_HOSTS=127.0.0.1,localhost
# Target read-only secret in DATAGUARD_TARGET_XXXX_PASSWORD (never database table)