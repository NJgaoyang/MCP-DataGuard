[Unit]
Description=DataGuard conservative encrypted backup retention
After=dataguard-postgres-backup.service
ConditionPathExists=/etc/dataguard/backup.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/dataguard/backup.env
Environment=DG_BACKUP_RETENTION_DAYS=30
Environment=DG_BACKUP_MIN_COPIES=2
Environment=DG_BACKUP_PRUNE_APPLY=yes
ExecStart=/usr/local/libexec/dataguard/prune-local-encrypted-backups.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dataguard/encrypted-backups
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
