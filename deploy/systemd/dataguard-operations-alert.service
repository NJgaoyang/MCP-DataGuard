[Unit]
Description=DataGuard security incident webhook notification
After=docker.service network-online.target
Wants=docker.service network-online.target
ConditionPathExists=/etc/dataguard/operations-alert.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/dataguard/operations-alert.env
ExecStart=/usr/local/libexec/dataguard/notify-operational-incidents.py
ReadWritePaths=/var/lib/dataguard/operations-alert-state
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TimeoutStartSec=45s
StandardOutput=journal
StandardError=journal
