[Unit]
Description=DataGuard encrypted PostgreSQL logical backup
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/etc/dataguard/backup.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=GNUPGHOME=/etc/dataguard/backup-public-keyring
EnvironmentFile=/etc/dataguard/backup.env
ExecStart=/usr/local/libexec/dataguard/backup-postgres-encrypted.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/dataguard/encrypted-backups
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
